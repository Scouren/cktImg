MN4 VEA net2 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN6 net1 net4 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN7 net4 net4 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN8 net4 VB4 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN9 VBP VB1 VSS VSS nch l=0.15 w=1 nf=1 m=1
MP1 net0 net0 VDD VDD pch l=0.15 w=1 nf=1 m=1
