MP3 net6 VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
MP4 net1 net1 net7 net7 pch l=0.15 w=1 nf=1 m=1
MP5 VX1 net1 net7 net7 pch l=0.15 w=1 nf=1 m=1
