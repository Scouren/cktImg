MP11 net3 net3 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP12 VB3 net3 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP13 VX2 net3 VDD VDD pch l=0.15 w=1 nf=1 m=1
