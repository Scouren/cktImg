MB8 VB2 VX VSS VSS nch l=0.15 w=1 nf=1 m=1
MB9 net0 VB2 VDD VDD pch l=0.15 w=1 nf=1 m=1
MN1 net2 VFP1 net6 VSS nch l=0.15 w=1 nf=1 m=1
MN2 VX3 VREF net6 VSS nch l=0.15 w=1 nf=1 m=1
MN3 net5 net5 VSS VSS nch l=0.15 w=1 nf=1 m=1
