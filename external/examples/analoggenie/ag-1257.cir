MN1 net0 VFP1 net7 VSS nch l=0.15 w=1 nf=1 m=1
MN10 net1 net1 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN11 net3 net1 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN12 net1 VB3 VSS VSS nch l=0.15 w=1 nf=1 m=1
