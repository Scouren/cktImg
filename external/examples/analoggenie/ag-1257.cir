MP6 net2 net2 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP7 net4 net4 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP8 VG net4 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP9 net3 net3 net5 VDD pch l=0.15 w=1 nf=1 m=1
R1 VP VFP1 1k
R2 VFP1 VSS 1k
RBIAS VG net6 1k
.ends dut
