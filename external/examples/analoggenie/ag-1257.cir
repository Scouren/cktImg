MN3 net7 VBN VSS VSS nch l=0.15 w=1 nf=1 m=1
MN4 net8 net8 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN5 VEA net8 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN6 VBN VBN VSS VSS nch l=0.15 w=1 nf=1 m=1
MN7 net2 VG VSS VSS nch l=0.15 w=1 nf=1 m=1
MN8 net4 VG VSS VSS nch l=0.15 w=1 nf=1 m=1
MN9 net6 VG VSS VSS nch l=0.15 w=1 nf=1 m=1
MP1 net0 net0 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP10 VX1 net3 net5 VDD pch l=0.15 w=1 nf=1 m=1
MP11 net1 VEA net5 VDD pch l=0.15 w=1 nf=1 m=1
MP2 net8 net0 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP3 VEA VX3 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP4 VX3 VX3 VDD VDD pch l=0.15 w=1 nf=1 m=1
