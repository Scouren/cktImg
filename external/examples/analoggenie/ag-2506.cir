Cm1 VOUT VA 1p
Cm2 VA net0 1p
M11 net4 VBN VSS VSS nch l=0.15 w=1 nf=1 m=1
M12 VX VFB net4 VSS nch l=0.15 w=1 nf=1 m=1
M13 VY VREF net4 VSS nch l=0.15 w=1 nf=1 m=1
