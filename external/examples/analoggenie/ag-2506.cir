M16 VY VB4 VIN VIN pch l=0.15 w=1 nf=1 m=1
M17 VY VY VSS VSS nch l=0.15 w=1 nf=1 m=1
M18 VY VA VSS VSS nch l=0.15 w=1 nf=1 m=1
M19 VA VX VIN VIN pch l=0.15 w=1 nf=1 m=1
M20 net8 VY VIN VIN pch l=0.15 w=1 nf=1 m=1
M21 net2 VA VSS VSS nch l=0.15 w=1 nf=1 m=1
M22 net1 VY VSS VSS nch l=0.15 w=1 nf=1 m=1
M23 net2 net2 VIN VIN pch l=0.15 w=1 nf=1 m=1
M24 net1 net2 VIN VIN pch l=0.15 w=1 nf=1 m=1
M25 VA net8 VSS VSS nch l=0.15 w=1 nf=1 m=1
M26 net8 net8 VSS VSS nch l=0.15 w=1 nf=1 m=1
MB1 VBN net6 VIN VIN pch l=0.15 w=1 nf=1 m=1
MB2 net6 net6 VIN VIN pch l=0.15 w=1 nf=1 m=1
MB3 VB1 net6 VIN VIN pch l=0.15 w=1 nf=1 m=1
MB4 VBN VBN VSS VSS nch l=0.15 w=1 nf=1 m=1
MB5 net6 VB1 VSS VSS nch l=0.15 w=1 nf=1 m=1
MB6 net3 VB1 VSS VSS nch l=0.15 w=1 nf=1 m=1
MD1 net0 VA VSS VSS nch l=0.15 w=1 nf=1 m=1
MD2 net7 VB2 VSS VSS nch l=0.15 w=1 nf=1 m=1
MD3 net5 net0 net7 VSS nch l=0.15 w=1 nf=1 m=1
MD4 VX VB3 net7 VSS nch l=0.15 w=1 nf=1 m=1
MD5 net0 VX VIN VIN pch l=0.15 w=1 nf=1 m=1
MD6 VX VX VIN VIN pch l=0.15 w=1 nf=1 m=1
MD7 net5 net5 VIN VIN pch l=0.15 w=1 nf=1 m=1
MPT VOUT net1 VIN VIN pch l=0.15 w=1 nf=1 m=1
RB VB1 net3 1k
RF1 VOUT VFB 1k
RF2 VFB VSS 1k
.ends dut
