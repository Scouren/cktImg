M5 VP VC3 VX3 VDD pch l=0.15 w=1 nf=1 m=1
M6 VX1 VG VS VDD pch l=0.15 w=1 nf=1 m=1
M7 VG VG VS VDD pch l=0.15 w=1 nf=1 m=1
M8 net2 VEA VS VDD pch l=0.15 w=1 nf=1 m=1
M9 net2 net2 VSS VSS nch l=0.15 w=1 nf=1 m=1
R1 VP VFP1 1k
R2 VFP1 VSS 1k
.ends dut
