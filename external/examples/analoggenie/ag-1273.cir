* official Analog Canvas netlist; PDK X cards rewritten by convert.py
.model nch nmos
.model pch pmos

.subckt dut VDD VSS VIN VP VC5 VC1 VC2 VC4 VC3 VB3 VREF
.model DIODE D(IS=1e-14 N=1)
CFLY VX1 VX2 1p
CO VP VN 1p
COP VP VSS 1p
D1 VN VX2 DIODE
L1 VX1 VX3 1n
M1 VS VC5 VIN VDD pch l=0.15 w=1 nf=1 m=1
M10 VG net2 VSS VSS nch l=0.15 w=1 nf=1 m=1
M11 net2 VB3 VSS VSS nch l=0.15 w=1 nf=1 m=1
