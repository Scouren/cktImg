M16 VX3 VREF net4 VSS nch l=0.15 w=1 nf=1 m=1
M17 net3 VFP1 net4 VSS nch l=0.15 w=1 nf=1 m=1
M18 net4 VB4 VSS VSS nch l=0.15 w=1 nf=1 m=1
M19 net1 net1 VSS VSS nch l=0.15 w=1 nf=1 m=1
M2 VX1 VC1 VIN VDD pch l=0.15 w=1 nf=1 m=1
M20 VEA net1 VSS VSS nch l=0.15 w=1 nf=1 m=1
M21 net0 net0 VDD VDD pch l=0.15 w=1 nf=1 m=1
M22 VB4 net0 VDD VDD pch l=0.15 w=1 nf=1 m=1
M23 VB1 VB1 VDD VDD pch l=0.15 w=1 nf=1 m=1
M24 net0 VB5 VSS VSS nch l=0.15 w=1 nf=1 m=1
M25 VB4 VB4 VSS VSS nch l=0.15 w=1 nf=1 m=1
M26 VB1 VB4 VSS VSS nch l=0.15 w=1 nf=1 m=1
M27 VB5 VB2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M28 VB2 VB2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M29 VS VB2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M3 VX2 VC2 VIN VDD pch l=0.15 w=1 nf=1 m=1
M30 VB5 VB5 VSS VSS nch l=0.15 w=1 nf=1 m=1
M31 VB2 VB5 VX2 VSS nch l=0.15 w=1 nf=1 m=1
