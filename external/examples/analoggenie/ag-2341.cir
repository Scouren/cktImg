M21 VSS IBUF GATE VDD pch l=0.15 w=1 nf=1 m=1
M22 VBN VBN VSS VSS nch l=0.15 w=1 nf=1 m=1
M23 net6 VB2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M24 net8 VB2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M25 VB2 net10 VSS VSS nch l=0.15 w=1 nf=1 m=1
M26 net6 net6 net10 VSS nch l=0.15 w=1 nf=1 m=1
M27 net10 net6 net7 VSS nch l=0.15 w=1 nf=1 m=1
M28 net8 net8 net7 VSS nch l=0.15 w=1 nf=1 m=1
M29 net7 net8 VX VSS nch l=0.15 w=1 nf=1 m=1
M3 net5 VREF net9 VSS nch l=0.15 w=1 nf=1 m=1
M30 VB2 VB2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M31 VX VB2 VDD VDD pch l=0.15 w=1 nf=1 m=1
