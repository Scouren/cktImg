MN2 net7 VFP1 net6 VSS nch l=0.15 w=1 nf=1 m=1
MN3 net6 VB2 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN4 net5 net1 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN5 VDR3 net1 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN6 net0 VDR3 VSS VSS nch l=0.15 w=1 nf=1 m=1
