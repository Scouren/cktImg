M4 net5 net6 VDD VDD pch l=0.15 w=1 nf=1 m=1
M5 net11 net6 VDD VDD pch l=0.15 w=1 nf=1 m=1
M6 VEAOUT VB1 net5 VDD pch l=0.15 w=1 nf=1 m=1
M7 net6 VB1 net11 VDD pch l=0.15 w=1 nf=1 m=1
M8 net10 VEAOUT net12 VDD pch l=0.15 w=1 nf=1 m=1
