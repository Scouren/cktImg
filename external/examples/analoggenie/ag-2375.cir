M18 VY VC net7 VSS nch l=0.15 w=1 nf=1 m=1
M19 VEAOUT VC VSS VSS nch l=0.15 w=1 nf=1 m=1
M2 net2 net2 VX VDD pch l=0.15 w=1 nf=1 m=1
M20 VC VC VEAOUT VSS nch l=0.15 w=1 nf=1 m=1
M21 VC net3 VDD VDD pch l=0.15 w=1 nf=1 m=1
M22 net3 net3 VDD VDD pch l=0.15 w=1 nf=1 m=1
M23 VB3 net3 VDD VDD pch l=0.15 w=1 nf=1 m=1
M24 VB3 VB3 VSS VSS nch l=0.15 w=1 nf=1 m=1
M25 net3 VB3 net4 VSS nch l=0.15 w=1 nf=1 m=1
