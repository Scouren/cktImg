M26 VBN VB3 VSS VSS nch l=0.15 w=1 nf=1 m=1
M27 VCN VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
M28 VCN VCN VTN VSS nch l=0.15 w=1 nf=1 m=1
M29 VTN VTN VSS VSS nch l=0.15 w=1 nf=1 m=1
