M21 VX VBN VSS VSS nch l=0.15 w=1 nf=1 m=1
M22 net1 VBN VSS VSS nch l=0.15 w=1 nf=1 m=1
M23 VBP VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
M24 VBN VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
