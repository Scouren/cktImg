M27 net5 VB2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M28 net3 VB2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M29 VB2 net7 VSS VSS nch l=0.15 w=1 nf=1 m=1
M3 net0 VREF VX VSS nch l=0.15 w=1 nf=1 m=1
M30 net1 net1 net7 VSS nch l=0.15 w=1 nf=1 m=1
