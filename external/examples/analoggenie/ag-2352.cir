M16 GATE VX VSS VSS nch l=0.15 w=1 nf=1 m=1
M17 VDD net8 GATE VSS nch l=0.15 w=1 nf=1 m=1
M18 net6 EAO IBUF IBUF nch l=0.15 w=1 nf=1 m=1
M19 net6 net6 VDD VDD pch l=0.15 w=1 nf=1 m=1
M2 VBN net9 VDD VDD pch l=0.15 w=1 nf=1 m=1
