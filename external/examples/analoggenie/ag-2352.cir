M5 VX VBN VSS VSS nch l=0.15 w=1 nf=1 m=1
M6 net4 net4 VSS VSS nch l=0.15 w=1 nf=1 m=1
M7 net9 net3 VSS VSS nch l=0.15 w=1 nf=1 m=1
M8 EAO net4 VSS VSS nch l=0.15 w=1 nf=1 m=1
M9 net2 net2 VDD VDD pch l=0.15 w=1 nf=1 m=1
MNP VIN GATE VOUT VOUT nch l=0.15 w=1 nf=1 m=1
