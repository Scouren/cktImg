MN2 net5 VFP1 net2 VSS nch l=0.15 w=1 nf=1 m=1
MN3 net2 VB6 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN4 VCTRL VB5 net6 VSS nch l=0.15 w=1 nf=1 m=1
MN5 net1 VB5 VM VSS nch l=0.15 w=1 nf=1 m=1
MN6 net6 net1 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN7 VM net1 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN8 VM VM VSS VSS nch l=0.15 w=1 nf=1 m=1
MN9 net3 VM VSS VSS nch l=0.15 w=1 nf=1 m=1
MP1 net4 VB1 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP10 VB3 net0 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP2 net5 VB1 VDD VDD pch l=0.15 w=1 nf=1 m=1
