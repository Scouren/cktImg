MN10 VM VB4 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN11 VB5 VB5 VB6 VSS nch l=0.15 w=1 nf=1 m=1
MN12 VB6 VB6 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN13 VB3 VB3 VSS VSS nch l=0.15 w=1 nf=1 m=1
