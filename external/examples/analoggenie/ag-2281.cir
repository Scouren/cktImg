M21 VSS IBUF GATE VDD pch l=0.15 w=1 nf=1 m=1
M22 VX VBN net9 VSS nch l=0.15 w=1 nf=1 m=1
M23 net6 VBN net8 VSS nch l=0.15 w=1 nf=1 m=1
M24 net9 VX VSS VSS nch l=0.15 w=1 nf=1 m=1
M25 net8 net6 VSS VSS nch l=0.15 w=1 nf=1 m=1
M26 net1 VBN VSS VSS nch l=0.15 w=1 nf=1 m=1
M27 VBN net2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M28 net2 net2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M29 VB3 net2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M3 VX VREF EAO VDD pch l=0.15 w=1 nf=1 m=1
