M20 GATE net4 VDD VDD pch l=0.15 w=1 nf=1 m=1
M21 VSS IBUF GATE VDD pch l=0.15 w=1 nf=1 m=1
M22 net11 net7 VDD VDD pch l=0.15 w=1 nf=1 m=1
M23 net11 net11 net13 VSS nch l=0.15 w=1 nf=1 m=1
M24 net13 net11 VSS VSS nch l=0.15 w=1 nf=1 m=1
