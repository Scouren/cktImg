M28 net1 net0 VSS VSS nch l=0.15 w=1 nf=1 m=1
M3 net0 VREF EAO VDD pch l=0.15 w=1 nf=1 m=1
M4 net2 FB EAO VDD pch l=0.15 w=1 nf=1 m=1
M5 net9 net2 VSS VSS nch l=0.15 w=1 nf=1 m=1
