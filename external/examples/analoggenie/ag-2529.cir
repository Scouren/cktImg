M5 net0 net0 VSS VSS nch l=0.15 w=1 nf=1 m=1
M6 net1 net0 VSS VSS nch l=0.15 w=1 nf=1 m=1
M7 net1 net1 VIN VDD pch l=0.15 w=1 nf=1 m=1
M8 VBN net1 VIN VDD pch l=0.15 w=1 nf=1 m=1
M9 VBN VBN VSS VSS nch l=0.15 w=1 nf=1 m=1
MD1 net2 VO1 VSS VSS nch l=0.15 w=1 nf=1 m=1
