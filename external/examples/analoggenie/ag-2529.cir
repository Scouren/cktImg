MD7 VY VY VIN VDD pch l=0.15 w=1 nf=1 m=1
MPT VOUT net6 VIN VDD pch l=0.15 w=1 nf=1 m=1
R1 VIN net0 1k
RF1 VOUT VFB 1k
RF2 VFB VSS 1k
.ends dut
