MN3 VB3 VB3 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN4 net3 VB3 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN5 net6 net6 VSS VSS nch l=0.15 w=1 nf=1 m=1
