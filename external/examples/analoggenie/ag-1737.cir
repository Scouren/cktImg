M8 net13 net2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M9 Y VB1 net3 VDD pch l=0.15 w=1 nf=1 m=1
Q1 VSS VSS net12 qpnp m=1
Q2 VSS net12 X qpnp m=1
Q3 VSS VSS Z qpnp m=1
Q4 VSS Z net6 qpnp m=1
R1 Y net6 1k
R2 Vout Y 1k
.ends dut
