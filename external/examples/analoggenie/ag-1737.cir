M14 Z X net4 VSS nch l=0.15 w=1 nf=1 m=1
M15 net2 Y net4 VSS nch l=0.15 w=1 nf=1 m=1
M16 VG VB4 net9 VSS nch l=0.15 w=1 nf=1 m=1
M17 net14 Y VSS VSS nch l=0.15 w=1 nf=1 m=1
M18 net4 VB2 VSS VSS nch l=0.15 w=1 nf=1 m=1
M19 net9 Y VSS VSS nch l=0.15 w=1 nf=1 m=1
M2 Vout VG VDD VDD pch l=0.15 w=1 nf=1 m=1
M20 VB5 VB5 VDD VDD pch l=0.15 w=1 nf=1 m=1
M21 net11 VB5 VDD VDD pch l=0.15 w=1 nf=1 m=1
M22 net10 VB5 VDD VDD pch l=0.15 w=1 nf=1 m=1
M23 VB3 VB5 VDD VDD pch l=0.15 w=1 nf=1 m=1
M24 VB4 VB5 VDD VDD pch l=0.15 w=1 nf=1 m=1
M25 VB5 net0 VSS VSS nch l=0.15 w=1 nf=1 m=1
M26 net11 net11 net0 VSS nch l=0.15 w=1 nf=1 m=1
M27 net10 net10 net7 VSS nch l=0.15 w=1 nf=1 m=1
M28 VB4 VB4 net5 VSS nch l=0.15 w=1 nf=1 m=1
M29 net0 net11 net7 VSS nch l=0.15 w=1 nf=1 m=1
M3 net12 VG VDD VDD pch l=0.15 w=1 nf=1 m=1
M30 net7 net10 VB3 VSS nch l=0.15 w=1 nf=1 m=1
