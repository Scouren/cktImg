* official Analog Canvas netlist; PDK X cards rewritten by convert.py
.model nch nmos
.model pch pmos

.subckt dut VDD VSS Vin Vout Vb1 Vb2 Vb3
CL Vout VSS 1p
ISS net3 VSS DC 1m
M1 X Vin net3 VSS nch l=0.15 w=1 nf=1 m=1
M10 Y Vb1 VDD VDD pch l=0.15 w=1 nf=1 m=1
M3 net0 Vb2 X VDD pch l=0.15 w=1 nf=1 m=1
M4 Vout Vb2 Y VDD pch l=0.15 w=1 nf=1 m=1
M5 net0 Vb3 net2 VSS nch l=0.15 w=1 nf=1 m=1
M6 Vout Vb3 net1 VSS nch l=0.15 w=1 nf=1 m=1
M7 net2 net0 VSS VSS nch l=0.15 w=1 nf=1 m=1
M8 net1 net0 VSS VSS nch l=0.15 w=1 nf=1 m=1
M9 X Vb1 VDD VDD pch l=0.15 w=1 nf=1 m=1
.ends dut
