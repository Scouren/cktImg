M15 VN VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
M16 VN VN VEA VSS nch l=0.15 w=1 nf=1 m=1
M17 VEA VN VSS VSS nch l=0.15 w=1 nf=1 m=1
M18 net2 VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
M19 VBP VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
M2 VX VX net6 VDD pch l=0.15 w=1 nf=1 m=1
M20 VB4 VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
M21 VBP VB4 net9 VSS nch l=0.15 w=1 nf=1 m=1
M22 VB4 VB4 VSS VSS nch l=0.15 w=1 nf=1 m=1
M23 net9 net2 VSS VSS nch l=0.15 w=1 nf=1 m=1
M24 net2 net2 VSS VSS nch l=0.15 w=1 nf=1 m=1
M3 VX nb VSS VSS nch l=0.15 w=1 nf=1 m=1
