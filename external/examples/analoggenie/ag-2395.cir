M5 VX VB3 net4 VDD pch l=0.15 w=1 nf=1 m=1
M6 VX VN net7 VSS nch l=0.15 w=1 nf=1 m=1
M7 net7 VX VSS VSS nch l=0.15 w=1 nf=1 m=1
M8 net0 VB1 VDD VDD pch l=0.15 w=1 nf=1 m=1
M9 VEA VB3 net0 VDD pch l=0.15 w=1 nf=1 m=1
MBIAS VERR nb VSS VSS nch l=0.15 w=1 nf=1 m=1
