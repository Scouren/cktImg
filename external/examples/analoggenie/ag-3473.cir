M36 net10 net8 net5 VSS nch l=0.15 w=1 nf=1 m=1
M37 VQ VQ net5 VSS nch l=0.15 w=1 nf=1 m=1
M38 net5 VQ VB3 VSS nch l=0.15 w=1 nf=1 m=1
M39 VB3 VB3 VSS VSS nch l=0.15 w=1 nf=1 m=1
M4 VC phi1 net1 VSS nch l=0.15 w=1 nf=1 m=1
M5 VX phi2 VD VSS nch l=0.15 w=1 nf=1 m=1
M6 VD phi1 net1 VSS nch l=0.15 w=1 nf=1 m=1
