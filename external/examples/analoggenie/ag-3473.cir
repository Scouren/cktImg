M27 VB4 VP VDD VDD pch l=0.15 w=1 nf=1 m=1
M28 VB4 VB4 net4 VSS nch l=0.15 w=1 nf=1 m=1
M29 net4 VB4 VSS VSS nch l=0.15 w=1 nf=1 m=1
M3 vin phi2 VC VSS nch l=0.15 w=1 nf=1 m=1
M30 VP VP VDD VDD pch l=0.15 w=1 nf=1 m=1
