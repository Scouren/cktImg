M15 net3 VN VSS VSS nch l=0.15 w=1 nf=1 m=1
M16 VD net7 VDD VDD pch l=0.15 w=1 nf=1 m=1
M17 net7 VB1 VD VDD pch l=0.15 w=1 nf=1 m=1
M18 net7 VX net11 VSS nch l=0.15 w=1 nf=1 m=1
M19 net2 net0 VDD VDD pch l=0.15 w=1 nf=1 m=1
M2 VA phi2 VSS VSS nch l=0.15 w=1 nf=1 m=1
