* official Analog Canvas netlist; PDK X cards rewritten by convert.py
.model nch nmos
.model pch pmos

.subckt opamp VDD VSS INN INP OUT
M10 VB1 VB1 VDD VDD pch l=0.15 w=1 nf=1 m=1
M11 OUT VB1 VDD VDD pch l=0.15 w=1 nf=1 m=1
M12 VB1 INN net2 VSS nch l=0.15 w=1 nf=1 m=1
M13 OUT INP net2 VSS nch l=0.15 w=1 nf=1 m=1
M14 net2 VB2 VSS VSS nch l=0.15 w=1 nf=1 m=1
M5 net0 net0 net1 VSS nch l=0.15 w=1 nf=1 m=1
M6 VB1 net0 VSS VSS nch l=0.15 w=1 nf=1 m=1
M7 VB1 VB1 VDD VDD pch l=0.15 w=1 nf=1 m=1
M8 VB2 VB1 VDD VDD pch l=0.15 w=1 nf=1 m=1
M9 VB2 VB2 VSS VSS nch l=0.15 w=1 nf=1 m=1
R1 VDD net0 1k
R2 net1 VSS 1k
.ends opamp

.subckt dut VDD VSS vci phi1 phi2 vco
C1 net2 net1 1p
C2 net0 vco 1p
M1 vci phi1 net2 VSS nch l=0.15 w=1 nf=1 m=1
M2 net2 phi2 VSS VSS nch l=0.15 w=1 nf=1 m=1
M3 net1 phi1 VSS VSS nch l=0.15 w=1 nf=1 m=1
M4 net1 phi2 net0 VSS nch l=0.15 w=1 nf=1 m=1
X1 VDD VSS net0 VSS vco opamp
.ends dut
