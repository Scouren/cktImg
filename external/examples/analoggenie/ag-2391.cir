M7 VX VB3 net2 VDD pch l=0.15 w=1 nf=1 m=1
M8 net8 VREF net0 VSS nch l=0.15 w=1 nf=1 m=1
M9 net2 VEA net0 VSS nch l=0.15 w=1 nf=1 m=1
MBIAS VERR nb VSS VSS nch l=0.15 w=1 nf=1 m=1
