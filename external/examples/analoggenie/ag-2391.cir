M15 VY VY VEA VSS nch l=0.15 w=1 nf=1 m=1
M16 VY net5 VDD VDD pch l=0.15 w=1 nf=1 m=1
M17 net5 net5 net4 VDD pch l=0.15 w=1 nf=1 m=1
M18 net7 VX VSS VSS nch l=0.15 w=1 nf=1 m=1
M2 VX VX net1 VDD pch l=0.15 w=1 nf=1 m=1
M3 VX nb VSS VSS nch l=0.15 w=1 nf=1 m=1
