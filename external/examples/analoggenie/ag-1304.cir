MN1 net3 net3 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN10 net2 net4 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN2 VX2 VX2 VSS VSS nch l=0.15 w=1 nf=1 m=1
