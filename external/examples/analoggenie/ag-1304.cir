MN4 net1 VX2 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN5 VBP net6 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN6 net6 net6 net7 VSS nch l=0.15 w=1 nf=1 m=1
MN7 VB1 VB1 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN8 net4 net4 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN9 net4 VB2 VSS VSS nch l=0.15 w=1 nf=1 m=1
MP1 net3 VFP1 net5 VDD pch l=0.15 w=1 nf=1 m=1
MP10 VX1 net2 VS VDD pch l=0.15 w=1 nf=1 m=1
