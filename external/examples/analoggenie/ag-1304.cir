MP4 net1 net1 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP5 net0 net1 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP6 VBP VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
MP7 VB1 VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
