M5 VA VS5 VIN VDD pch l=0.15 w=1 nf=1 m=1
MN1 VX2 VX2 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN10 net3 net3 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN11 VB2 net3 VX2 VSS nch l=0.15 w=1 nf=1 m=1
MN12 VA VA VSS VSS nch l=0.15 w=1 nf=1 m=1
MN13 VX2 VA VSS VSS nch l=0.15 w=1 nf=1 m=1
MN2 net4 VX2 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN3 VEA net2 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN4 net2 net2 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN5 net0 net5 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN6 net5 net5 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN7 net5 VB3 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN8 VB1 VB1 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN9 VB4 net3 VSS VSS nch l=0.15 w=1 nf=1 m=1
MP1 net4 net4 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP10 VB4 VB4 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP11 net3 VB2 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP12 VB2 VB2 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP13 VA VB2 VDD VDD pch l=0.15 w=1 nf=1 m=1
