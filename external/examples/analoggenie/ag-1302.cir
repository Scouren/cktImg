MP5 net2 VFP1 net1 VDD pch l=0.15 w=1 nf=1 m=1
MP6 VX1 net0 VA VDD pch l=0.15 w=1 nf=1 m=1
MP7 net0 net0 VA VDD pch l=0.15 w=1 nf=1 m=1
MP8 net5 VEA VA VDD pch l=0.15 w=1 nf=1 m=1
MP9 VB1 VB4 VDD VDD pch l=0.15 w=1 nf=1 m=1
R1 VP VFP1 1k
R2 VFP1 VSS 1k
.ends dut
