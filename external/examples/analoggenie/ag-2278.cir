M6 net1 net9 VDD VDD pch l=0.15 w=1 nf=1 m=1
M7 VX VB1 net5 VDD pch l=0.15 w=1 nf=1 m=1
M8 EAO VB1 net1 VDD pch l=0.15 w=1 nf=1 m=1
M9 VX VBN net13 VSS nch l=0.15 w=1 nf=1 m=1
MNP VIN GATE VOUT VSS nch l=0.15 w=1 nf=1 m=1
