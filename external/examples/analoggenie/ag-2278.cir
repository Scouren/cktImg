M24 VT VB2 VSS VSS nch l=0.15 w=1 nf=1 m=1
M25 net6 VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
M26 net6 net6 VSS VSS nch l=0.15 w=1 nf=1 m=1
M27 VBP VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
M28 VBP VB3 net12 VSS nch l=0.15 w=1 nf=1 m=1
M29 net12 net6 VSS VSS nch l=0.15 w=1 nf=1 m=1
M3 net9 VREF VT VSS nch l=0.15 w=1 nf=1 m=1
M30 VB3 VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
