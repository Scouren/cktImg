MN5 VEA net0 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN7 net6 net6 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN8 net1 net6 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN9 net6 VB3 VSS VSS nch l=0.15 w=1 nf=1 m=1
MP1 net4 net4 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP10 VB2 VB2 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP11 net5 net5 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP12 VBN net5 VDD VDD pch l=0.15 w=1 nf=1 m=1
