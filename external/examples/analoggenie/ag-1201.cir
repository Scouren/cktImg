.ends EA1

.subckt ISR VDD VSS VB4 VISR VEA VX1
MN5 net0 net0 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN6 net1 net0 VSS VSS nch l=0.15 w=1 nf=1 m=1
