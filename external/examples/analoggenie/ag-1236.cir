MN4 net7 VB2 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN5 VBN VBN net9 VSS nch l=0.15 w=1 nf=1 m=1
MN6 net9 VBN VSS VSS nch l=0.15 w=1 nf=1 m=1
MN7 net10 VB4 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN8 VB4 VB4 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN9 net3 net3 VSS VSS nch l=0.15 w=1 nf=1 m=1
MP1 net1 VB1 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP10 VB4 net10 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP11 net3 VCTRL VISR VISR pch l=0.15 w=1 nf=1 m=1
MP12 net6 net6 VISR VISR pch l=0.15 w=1 nf=1 m=1
MP13 VX1 net6 VISR VISR pch l=0.15 w=1 nf=1 m=1
