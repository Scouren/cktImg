M27 Out net17 V+ V+ pch l=0.15 w=1 nf=1 m=1
M28 Out net7 V- V- nch l=0.15 w=1 nf=1 m=1
M3 VBP net4 net10 V- nch l=0.15 w=1 nf=1 m=1
M4 net10 net4 V- V- nch l=0.15 w=1 nf=1 m=1
M5 net5 VBP V+ V+ pch l=0.15 w=1 nf=1 m=1
