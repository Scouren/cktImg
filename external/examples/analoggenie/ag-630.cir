M15 net13 net4 net12 V- nch l=0.15 w=1 nf=1 m=1
M16 net12 net4 V- V- nch l=0.15 w=1 nf=1 m=1
M17 net7 net4 net0 V- nch l=0.15 w=1 nf=1 m=1
M18 net0 net4 V- V- nch l=0.15 w=1 nf=1 m=1
M19 net7 net15 net17 V+ pch l=0.15 w=1 nf=1 m=1
M2 net16 net4 V- V- nch l=0.15 w=1 nf=1 m=1
M20 net15 net4 V- V- nch l=0.15 w=1 nf=1 m=1
M21 net9 net9 V+ V+ pch l=0.15 w=1 nf=1 m=1
M22 net15 net15 net9 V+ pch l=0.15 w=1 nf=1 m=1
M23 net17 net1 net7 V- nch l=0.15 w=1 nf=1 m=1
M24 net1 VBP V+ V+ pch l=0.15 w=1 nf=1 m=1
M25 net1 net1 net14 V- nch l=0.15 w=1 nf=1 m=1
