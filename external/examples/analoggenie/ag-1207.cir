M36 net8 VB5 VSS VSS nch l=0.15 w=1 nf=1 m=1
M4 VX3 VC4 VSS VSS nch l=0.15 w=1 nf=1 m=1
M5 VS VC1 VIN VDD pch l=0.15 w=1 nf=1 m=1
M6 net4 net6 VDD VDD pch l=0.15 w=1 nf=1 m=1
M7 net6 VB1 net4 VDD pch l=0.15 w=1 nf=1 m=1
