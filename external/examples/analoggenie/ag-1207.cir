M25 VX1 net0 VS VDD pch l=0.15 w=1 nf=1 m=1
M26 net0 net1 VSS VSS nch l=0.15 w=1 nf=1 m=1
M27 VBP VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
M28 VB3 VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
M29 VS VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
M3 VP VC5 VX3 VDD pch l=0.15 w=1 nf=1 m=1
M30 VB5 VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
M31 VBP VB3 VX2 VSS nch l=0.15 w=1 nf=1 m=1
