M20 V1 VC VIN VDD pch l=0.15 w=1 nf=1 m=1
M21 net3 V1 VSS VSS nch l=0.15 w=1 nf=1 m=1
M22 net9 VA VSS VSS nch l=0.15 w=1 nf=1 m=1
