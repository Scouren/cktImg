M15 net6 VG VSS VSS nch l=0.15 w=1 nf=1 m=1
M16 VB4 VB6 VDD VDD pch l=0.15 w=1 nf=1 m=1
M17 VB6 VB6 VDD VDD pch l=0.15 w=1 nf=1 m=1
M18 net1 VB6 VDD VDD pch l=0.15 w=1 nf=1 m=1
M19 VB5 VB6 VDD VDD pch l=0.15 w=1 nf=1 m=1
M2 net8 FB net3 VSS nch l=0.15 w=1 nf=1 m=1
M20 VB6 VB4 VB3 VSS nch l=0.15 w=1 nf=1 m=1
M21 VB5 VB5 net5 VSS nch l=0.15 w=1 nf=1 m=1
M22 VB4 VB3 VSS VSS nch l=0.15 w=1 nf=1 m=1
