M4 net7 net0 VDD VDD pch l=0.15 w=1 nf=1 m=1
M5 net4 net0 VDD VDD pch l=0.15 w=1 nf=1 m=1
M6 net2 net8 VDD VDD pch l=0.15 w=1 nf=1 m=1
M7 net10 net8 VDD VDD pch l=0.15 w=1 nf=1 m=1
M8 net0 VB1 net7 VDD pch l=0.15 w=1 nf=1 m=1
