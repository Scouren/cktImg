M4 VE3 VG VDD VDD pch l=0.15 w=1 nf=1 m=1
M5 VE3 VB1 VDD VDD pch l=0.15 w=1 nf=1 m=1
M6 net3 Y VE3 VDD pch l=0.15 w=1 nf=1 m=1
M7 net6 X VE3 VDD pch l=0.15 w=1 nf=1 m=1
M8 net0 VE4 VDD VDD pch l=0.15 w=1 nf=1 m=1
