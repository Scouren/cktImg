M15 net6 VB5 VSS VSS nch l=0.15 w=1 nf=1 m=1
M16 VB4 net4 VDD VDD pch l=0.15 w=1 nf=1 m=1
M17 VB4 VB4 VB5 VSS nch l=0.15 w=1 nf=1 m=1
M18 VB5 VB5 VSS VSS nch l=0.15 w=1 nf=1 m=1
M19 net4 net4 VDD VDD pch l=0.15 w=1 nf=1 m=1
M2 Vout VG VDD VDD pch l=0.15 w=1 nf=1 m=1
M20 net4 VB3 net2 VSS nch l=0.15 w=1 nf=1 m=1
M21 net2 net1 VSS VSS nch l=0.15 w=1 nf=1 m=1
M22 net1 net4 VDD VDD pch l=0.15 w=1 nf=1 m=1
M23 net1 net1 VSS VSS nch l=0.15 w=1 nf=1 m=1
M24 VB3 net4 VDD VDD pch l=0.15 w=1 nf=1 m=1
