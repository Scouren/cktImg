MCTRL VERR VX VOUT VDD pch l=0.15 w=1 nf=1 m=1
MGEN net8 net8 VSS VSS nch l=0.15 w=1 nf=1 m=1
MINJ VERR net8 VSS VSS nch l=0.15 w=1 nf=1 m=1
MRES VOUT VERR VIN VDD pch l=0.15 w=1 nf=1 m=1
MSEN net8 VEAOUT net5 VDD pch l=0.15 w=1 nf=1 m=1
R1 net6 VSS 1k
.ends dut
