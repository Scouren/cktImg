M27 net0 net2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M28 net0 VB4 VSS VSS nch l=0.15 w=1 nf=1 m=1
M3 net3 VREF net0 VDD pch l=0.15 w=1 nf=1 m=1
M4 net4 FB net0 VDD pch l=0.15 w=1 nf=1 m=1
M5 net3 VB2 VSS VSS nch l=0.15 w=1 nf=1 m=1
M6 net4 VB2 VSS VSS nch l=0.15 w=1 nf=1 m=1
