M16 GATE VX VSS VSS nch l=0.15 w=1 nf=1 m=1
M17 VDD VY GATE VSS nch l=0.15 w=1 nf=1 m=1
M18 VZ EAO IB VSS nch l=0.15 w=1 nf=1 m=1
M19 VZ VZ VDD VDD pch l=0.15 w=1 nf=1 m=1
M2 net0 VB1 VDD VDD pch l=0.15 w=1 nf=1 m=1
M20 GATE VZ VDD VDD pch l=0.15 w=1 nf=1 m=1
M21 VSS IB GATE VDD pch l=0.15 w=1 nf=1 m=1
M22 VBN net2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M23 VBN VBN net6 VSS nch l=0.15 w=1 nf=1 m=1
M24 net6 VBN VSS VSS nch l=0.15 w=1 nf=1 m=1
M25 net2 net2 VDD VDD pch l=0.15 w=1 nf=1 m=1
