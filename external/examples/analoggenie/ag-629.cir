M15 net2 net2 net18 V- nch l=0.15 w=1 nf=1 m=1
M16 net18 net2 V- V- nch l=0.15 w=1 nf=1 m=1
M17 net15 net2 net10 V- nch l=0.15 w=1 nf=1 m=1
M18 net10 net2 V- V- nch l=0.15 w=1 nf=1 m=1
M19 net15 net6 net7 V+ pch l=0.15 w=1 nf=1 m=1
M2 net0 net0 net16 V+ pch l=0.15 w=1 nf=1 m=1
M20 net6 net8 V- V- nch l=0.15 w=1 nf=1 m=1
M21 net17 net17 V+ V+ pch l=0.15 w=1 nf=1 m=1
M22 net6 net6 net17 V+ pch l=0.15 w=1 nf=1 m=1
M23 net7 net1 net15 V- nch l=0.15 w=1 nf=1 m=1
M24 net1 net0 V+ V+ pch l=0.15 w=1 nf=1 m=1
