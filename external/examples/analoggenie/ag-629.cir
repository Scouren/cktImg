M27 Out net7 V+ V+ pch l=0.15 w=1 nf=1 m=1
M29 Out net15 V- V- nch l=0.15 w=1 nf=1 m=1
M3 net4 net0 V+ V+ pch l=0.15 w=1 nf=1 m=1
M4 net13 net0 net4 V+ pch l=0.15 w=1 nf=1 m=1
M5 net8 net13 net12 V- nch l=0.15 w=1 nf=1 m=1
