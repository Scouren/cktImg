MN8 VB6 VB6 net7 VSS nch l=0.15 w=1 nf=1 m=1
MN9 net7 VB6 VSS VSS nch l=0.15 w=1 nf=1 m=1
MP1 VFP1 net1 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP10 VBP VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
MP11 net10 VBP VDD VDD pch l=0.15 w=1 nf=1 m=1
