MP3 VN net5 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP4 net3 net5 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP5 VG VB1 VFP1 VDD pch l=0.15 w=1 nf=1 m=1
MP6 net1 VB1 net2 VDD pch l=0.15 w=1 nf=1 m=1
