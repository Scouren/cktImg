M4 net9 VP VIN VDD pch l=0.15 w=1 nf=1 m=1
M5 V1 VB5 net9 VDD pch l=0.15 w=1 nf=1 m=1
M6 V1 VN net1 VSS nch l=0.15 w=1 nf=1 m=1
M7 VW VW VIN VDD pch l=0.15 w=1 nf=1 m=1
