mp1 net15 clk VX1 VDD pch l=0.15 w=1 nf=1 m=1
mp2 net6 clk VDD VDD pch l=0.15 w=1 nf=1 m=1
mp3 net2 clk VDD VDD pch l=0.15 w=1 nf=1 m=1
.ends dut
