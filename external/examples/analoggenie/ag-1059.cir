* official Analog Canvas netlist; PDK X cards rewritten by convert.py
.model nch nmos
.model pch pmos

.subckt dut VDD VSS in_bar in clk clk_bar bias bias2 out out_bar
M1 VX1 VSS VDD VDD pch l=0.15 w=1 nf=1 m=1
M10 VY1 VSS VDD VDD pch l=0.15 w=1 nf=1 m=1
M11 VY2 VSS VDD VDD pch l=0.15 w=1 nf=1 m=1
