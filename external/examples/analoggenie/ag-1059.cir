M13 VY2 VX1 net6 VSS nch l=0.15 w=1 nf=1 m=1
M14 net1 VSS VDD VDD pch l=0.15 w=1 nf=1 m=1
M15 net13 VSS VDD VDD pch l=0.15 w=1 nf=1 m=1
M16 VY1 VY2 net2 VSS nch l=0.15 w=1 nf=1 m=1
M17 VY2 VY1 net2 VSS nch l=0.15 w=1 nf=1 m=1
M18 net12 bias VSS VSS nch l=0.15 w=1 nf=1 m=1
M19 net0 bias VSS VSS nch l=0.15 w=1 nf=1 m=1
M2 net15 VSS VDD VDD pch l=0.15 w=1 nf=1 m=1
M20 net3 VSS VDD VDD pch l=0.15 w=1 nf=1 m=1
M21 net3 clk net4 VSS nch l=0.15 w=1 nf=1 m=1
M22 net5 clk_bar net4 VSS nch l=0.15 w=1 nf=1 m=1
M23 VY2 VZ2 net5 VSS nch l=0.15 w=1 nf=1 m=1
M24 VY1 VZ1 net5 VSS nch l=0.15 w=1 nf=1 m=1
M25 net4 bias VSS VSS nch l=0.15 w=1 nf=1 m=1
M26 VZ1 VSS VDD VDD pch l=0.15 w=1 nf=1 m=1
M27 VZ2 VSS VDD VDD pch l=0.15 w=1 nf=1 m=1
M28 VZ1 VY2 net11 VSS nch l=0.15 w=1 nf=1 m=1
M29 VZ2 VY1 net11 VSS nch l=0.15 w=1 nf=1 m=1
M3 VX1 in_bar net14 VSS nch l=0.15 w=1 nf=1 m=1
M30 net11 bias2 VSS VSS nch l=0.15 w=1 nf=1 m=1
M31 VU1 VSS VDD VDD pch l=0.15 w=1 nf=1 m=1
M32 net10 VSS VDD VDD pch l=0.15 w=1 nf=1 m=1
M33 VU1 VZ1 net8 VSS nch l=0.15 w=1 nf=1 m=1
M34 net10 VZ2 net8 VSS nch l=0.15 w=1 nf=1 m=1
M35 net8 bias VSS VSS nch l=0.15 w=1 nf=1 m=1
M36 out_bar VSS VDD VDD pch l=0.15 w=1 nf=1 m=1
M37 out VSS VDD VDD pch l=0.15 w=1 nf=1 m=1
M38 out_bar net10 net16 VSS nch l=0.15 w=1 nf=1 m=1
M39 out VU1 net16 VSS nch l=0.15 w=1 nf=1 m=1
M4 net15 in net14 VSS nch l=0.15 w=1 nf=1 m=1
M40 net16 bias VSS VSS nch l=0.15 w=1 nf=1 m=1
M5 VX1 net15 net9 VSS nch l=0.15 w=1 nf=1 m=1
M6 net15 VX1 net9 VSS nch l=0.15 w=1 nf=1 m=1
