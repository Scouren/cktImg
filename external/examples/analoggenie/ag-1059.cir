M8 net9 clk net7 VSS nch l=0.15 w=1 nf=1 m=1
M9 net7 bias VSS VSS nch l=0.15 w=1 nf=1 m=1
mn1 net6 clk net12 VSS nch l=0.15 w=1 nf=1 m=1
mn2 net2 clk net0 VSS nch l=0.15 w=1 nf=1 m=1
