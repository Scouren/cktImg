M8 net1 VB5 net11 VSS nch l=0.15 w=1 nf=1 m=1
M9 EAO VB1 net7 VDD pch l=0.15 w=1 nf=1 m=1
MNP VIN GATE VOUT VSS nch l=0.15 w=1 nf=1 m=1
R1 FB VSS 1k
R2 VOUT FB 1k
R3 VB3 VSS 1k
R4 net5 VSS 1k
RL VOUT VSS 1k
.ends dut
