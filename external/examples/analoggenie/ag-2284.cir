M23 VX VB5 net3 VSS nch l=0.15 w=1 nf=1 m=1
M24 net12 net9 VSS VSS nch l=0.15 w=1 nf=1 m=1
M25 net3 VX VSS VSS nch l=0.15 w=1 nf=1 m=1
M26 net2 net2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M27 net4 net2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M28 net2 net4 VB3 VSS nch l=0.15 w=1 nf=1 m=1
M29 net4 VB3 VSS VSS nch l=0.15 w=1 nf=1 m=1
M3 VX VREF EAO VDD pch l=0.15 w=1 nf=1 m=1
M30 VB5 net2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M31 VB5 VB5 net8 VSS nch l=0.15 w=1 nf=1 m=1
