* official Analog Canvas netlist; PDK X cards rewritten by convert.py
.model nch nmos
.model pch pmos

.subckt dut VDD VSS VCONT1 VB4 VCONT2 VCONT4 VCONT5 VP VCONT3 VIN VB1 VB2 VREF
.model DIODE D(IS=1e-14 N=1)
CFLY VX1 VX2 1p
CO VP VN 1p
COP VP VSS 1p
D1 VN VX2 DIODE
L1 VX1 VX3 1n
M1 VIN VCONT1 net0 VDD pch l=0.15 w=1 nf=1 m=1
M2 VIN VCONT2 VX1 VDD pch l=0.15 w=1 nf=1 m=1
