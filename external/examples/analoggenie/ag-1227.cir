MN1 net8 VB6 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN10 VB7 net1 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN11 net1 net1 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN2 net7 VB6 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN3 VM VB5 net8 VSS nch l=0.15 w=1 nf=1 m=1
MN4 VCTRL VB5 net7 VSS nch l=0.15 w=1 nf=1 m=1
MN5 VB5 VB5 VB6 VSS nch l=0.15 w=1 nf=1 m=1
MN6 net4 net5 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN7 net5 net5 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN8 net5 VB4 VSS VSS nch l=0.15 w=1 nf=1 m=1
MN9 VB6 VB6 VSS VSS nch l=0.15 w=1 nf=1 m=1
MP1 net3 VB1 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP10 net2 VM VDD VDD pch l=0.15 w=1 nf=1 m=1
MP11 VB5 VB7 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP12 VB7 VB7 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP13 net1 VB7 VDD VDD pch l=0.15 w=1 nf=1 m=1
MP2 net8 VREF net3 VDD pch l=0.15 w=1 nf=1 m=1
MP3 net7 VFP1 net3 VDD pch l=0.15 w=1 nf=1 m=1
MP4 net4 net4 net0 VDD pch l=0.15 w=1 nf=1 m=1
