M13 VX1 VB2 VSS VSS nch l=0.15 w=1 nf=1 m=1
M14 VX2 VB2 VSS VSS nch l=0.15 w=1 nf=1 m=1
M15 VX5 net0 VDD VDD pch l=0.15 w=1 nf=1 m=1
M16 VX5 VX5 VEA VSS nch l=0.15 w=1 nf=1 m=1
M17 VEA VX5 VSS VSS nch l=0.15 w=1 nf=1 m=1
M18 net0 net0 VDD VDD pch l=0.15 w=1 nf=1 m=1
M19 net1 net0 VDD VDD pch l=0.15 w=1 nf=1 m=1
M2 VG VG VX1 VDD pch l=0.15 w=1 nf=1 m=1
M20 net0 net1 net3 VSS nch l=0.15 w=1 nf=1 m=1
M21 net1 net1 VSS VSS nch l=0.15 w=1 nf=1 m=1
M3 VG nb VSS VSS nch l=0.15 w=1 nf=1 m=1
M4 VG VB1 VDD VDD pch l=0.15 w=1 nf=1 m=1
M5 VX1 VREF VG VDD pch l=0.15 w=1 nf=1 m=1
M6 VX2 VEA VG VDD pch l=0.15 w=1 nf=1 m=1
M7 VX3 net2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M8 net4 net2 VDD VDD pch l=0.15 w=1 nf=1 m=1
M9 net2 VB3 VX3 VDD pch l=0.15 w=1 nf=1 m=1
MBIAS VERR nb VSS VSS nch l=0.15 w=1 nf=1 m=1
MCHG VX2 pb VIN VDD pch l=0.15 w=1 nf=1 m=1
MCTRL VERR VG VOUT VDD pch l=0.15 w=1 nf=1 m=1
