* official Analog Canvas netlist; PDK X cards rewritten by convert.py
.model nch nmos
.model pch pmos

.subckt dut VDD VSS Vin Vout
Is net2 VSS DC 1m
M1 net0 Vin net2 VSS nch l=0.15 w=1 nf=1 m=1
M2 Vout net1 net2 VSS nch l=0.15 w=1 nf=1 m=1
M3 net0 net0 VDD VDD pch l=0.15 w=1 nf=1 m=1
M4 Vout net0 VDD VDD pch l=0.15 w=1 nf=1 m=1
R1 Vout net1 1k
R2 net1 VSS 1k
.ends dut
